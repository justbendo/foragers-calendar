# GEMINI_API_KEY: Optional if server-side Gemini features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# PORT: Server HTTP port (default: 3000)
PORT="3000"

# DATABASE_URL: Relational database connection string with Prisma ORM
# For PostgreSQL:
DATABASE_URL="postgresql://forager_user:your_secure_password@localhost:5432/foragers_calendar?schema=public"

# For MariaDB / MySQL (requires copying prisma/schema.mariadb.prisma to prisma/schema.prisma):
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# DATABASE_URL="mysql://forager_user:your_secure_password@localhost:3306/foragers_calendar"

# WEATHER_PROVIDER: Configurable climate service provider ('open-meteo' | 'mock')
WEATHER_PROVIDER="open-meteo"
